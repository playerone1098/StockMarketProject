# StockVista Backend — Environment Variables
# Copy this file to .env and fill in your values

PORT=5000
# Connection URI (typically excludes database name path for clean isolation)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=StockVista
# Database override. If omitted, defaults to stockvista_prod in production and stockvista_dev in development/local.
MONGODB_DB_NAME=stockvista_dev
JWT_SECRET=<generate-a-strong-random-secret-min-32-chars>
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Optional API Key for live Indian IPO subscription details from indianapi.in
# If omitted, the server automatically runs in Realistic Live Simulator mode
INDIAN_API_KEY=your_indianapi_token_here
