# StockVista Backend — Environment Variables
# Copy this file to .env and fill in your values

PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?appName=StockVista
JWT_SECRET=<generate-a-strong-random-secret-min-32-chars>
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Optional API Key for live Indian IPO subscription details from indianapi.in
# If omitted, the server automatically runs in Realistic Live Simulator mode
INDIAN_API_KEY=your_indianapi_token_here
